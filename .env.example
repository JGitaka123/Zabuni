# NODE_ENV: development | test | production
# INTEGRATION_MODE: fixture | sandbox | live
# Production refuses to boot in fixture mode -- fixture transports accept every
# send and deliver nothing, so a production tenant would never receive an OTP.
# Until an approved email provider adapter is configured, sandbox/live API boot
# also fails closed instead of starting a service whose sign-in flow cannot send.
NODE_ENV=development
INTEGRATION_MODE=fixture

DATABASE_URL=postgres://zabuni_app:zabuni_app@localhost:5432/zabuni
DATABASE_AUTH_URL=postgres://zabuni_auth:zabuni_auth@localhost:5432/zabuni
DATABASE_WORKER_URL=postgres://zabuni_worker:zabuni_worker@localhost:5432/zabuni
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/zabuni
MIGRATION_DATABASE_URL=postgres://zabuni_migrator:zabuni_migrator@localhost:5432/zabuni
REDIS_URL=redis://localhost:6379

# Must be at least 32 characters. This placeholder is rejected in production.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# API origin (BETTER_AUTH_URL) and browser origin (WEB_ORIGIN) must both be
# https:// in production; WEB_ORIGIN is the single credentialed CORS origin.
PORT=3001
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Required in production. Sandbox and live modes send redacted errors when set;
# fixture mode stays offline even if a DSN is present.
SENTRY_DSN=

# Outbox drain worker. WORKER_ID doubles as the database claim owner and the
# telemetry correlation id, so it is limited to [A-Za-z0-9._-] and 100 chars.
# WORKER_LEASE_SECONDS must exceed WORKER_POLL_INTERVAL_MS or a lease expires
# before the next poll can renew it and another worker reclaims live work.
# WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_IDLE_POLL_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=60
WORKER_SHUTDOWN_GRACE_MS=15000
