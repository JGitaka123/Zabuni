{
  "name": "@zabuni/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./privileged/outbox": {
      "types": "./dist/privileged/outbox.d.ts",
      "import": "./dist/privileged/outbox.js"
    },
    "./privileged/catalog-tax": {
      "types": "./dist/privileged/catalog-tax.d.ts",
      "import": "./dist/privileged/catalog-tax.js"
    },
    "./privileged/catalog-matching": {
      "types": "./dist/privileged/catalog-matching.d.ts",
      "import": "./dist/privileged/catalog-matching.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.44.5",
    "postgres": "3.4.7",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "drizzle-kit": "0.31.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
